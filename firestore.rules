service cloud.firestore {
  function isAdmin() {
    // Set via Firebase Custom Claims: admin=true
    return request.auth != null && request.auth.token.admin == true;
  }

  match /databases/{database}/documents {
    // Users can read/write their own doc
    // Webhook activation is done via Firebase Admin SDK (privileged server credentials),
    // which bypasses these rules.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    
    // Admin uploads
    match /uploads/{docId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
    
    // Content: read if free or matches user plan, admin write
    match /lessons/{docId} {
      allow read: if request.auth != null && (
        resource.data.isFree == true ||
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
        resource.data.plan == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.plan
      ); // FIXED: Added exists() check prevents errors
      allow write: if isAdmin();
    }
    
    match /past_papers/{docId} {
      allow read: if request.auth != null && (
        resource.data.isFree == true ||
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
        resource.data.plan == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.plan
      ); // FIXED: Added exists() check prevents errors
      allow write: if isAdmin();
    }
    
    match /announcements/{docId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
  }
}

